{
  "name": "flowdocker-platform-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:forms": "vite build --config vite.forms.config.ts && node scripts/package-forms.mjs",
    "dev": "npm run dev -w @flowdocker/e-request-web",
    "dev:local": "npm run dev -w @flowdocker/e-request-web -- --host 127.0.0.1 --port 5174 --strictPort",
    "examples:ui": "vite packages/ui/examples --host 0.0.0.0",
    "examples:forms": "vite packages/form-builder/examples --config vite.config.ts --host 0.0.0.0",
    "build": "npm run build -w @flowdocker/e-request-web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && npm run i18n:check",
    "format:check": "prettier --check 'apps/e-request-web/src/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx,css}'",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "backend:setup": "node scripts/backend-setup.mjs",
    "backend:up": "docker compose --env-file .env.backend.local -f compose.backend.yml up -d --wait",
    "backend:migrate": "node --env-file=.env.backend.local scripts/backend-migrate.mjs",
    "backend:dev": "node --env-file=.env.backend.local --import tsx apps/api/src/main.ts",
    "backend:test": "node --env-file=.env.backend.local --import tsx --test apps/api/src/api.integration.ts apps/api/src/publication.integration.ts apps/api/src/tasks.integration.ts",
    "backend:seed": "node --env-file=.env.backend.local --import tsx scripts/backend-seed.ts",
    "approval:test": "node --env-file=.env.backend.local --import tsx --test apps/approval-worker/src/runtime.integration.ts",
    "approval:dev": "node --env-file=.env.backend.local --import tsx apps/approval-worker/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "5.1.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "cn": "^0.5.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1"
  }
}

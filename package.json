{
  "name": "flowdocker-platform-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @flowdocker/e-request-web",
    "examples:ui": "vite packages/ui/examples --host 0.0.0.0",
    "build": "npm run build -w @flowdocker/e-request-web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && npm run i18n:check",
    "format:check": "prettier --check 'apps/e-request-web/src/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx,css}'",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
